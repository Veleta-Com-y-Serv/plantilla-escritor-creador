---
// Cabecera fija a todo el ancho, siempre sólida en papel con una regla gruesa de tinta debajo (como la cabecera
// de un periódico): calderón «¶» + nombre en didona (o el logo), menú en letra de máquina (site.yaml → menu)
// y botón (site.yaml → boton_cabecera). En móvil, menú plegable sin JavaScript (<details>).
// Aspecto en src/styles/global.css (.cabecera--tipografico).
import { site } from '../data/site';
import type { Enlace } from '../data/site';
interface Props { variante?: string; cta?: Enlace | null }
const { variante = 'tipografico', cta = null } = Astro.props;
const boton = cta && cta.url && cta.texto ? cta : null;
---

<header class={`cabecera cabecera--${variante}`}>
  <div class="contenedor cabecera-fila">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      {
        site.logo ? (
          <img src={site.logo} alt={site.nombre} class="marca-logo" width="160" height="40" />
        ) : (
          <>
            <span class="marca-inicial" aria-hidden="true">¶</span>
            <span class="marca-nombre">{site.nombre}</span>
          </>
        )
      }
    </a>
    <nav class="cabecera-nav" aria-label="Menú principal">
      {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
    </nav>
    {boton && <a href={boton.url} class="btn cabecera-cta">{boton.texto}</a>}
    {
      (site.menu.length > 0 || boton) && (
        <details class="menu-movil">
          <summary aria-label="Abrir el menú">
            <span class="menu-movil-icono" aria-hidden="true" />
            <span>Menú</span>
          </summary>
          <nav class="menu-movil-panel" aria-label="Menú">
            {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
            {boton && <a href={boton.url} class="btn">{boton.texto}</a>}
          </nav>
        </details>
      )
    }
  </div>
</header>
<script is:inline>
  document.querySelectorAll('.menu-movil a').forEach(function (a) {
    a.addEventListener('click', function () { a.closest('details').open = false; });
  });
</script>
