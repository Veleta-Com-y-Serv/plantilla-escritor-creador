---
// Pie a todo el ancho en tinta, con columnas: calderón y nombre en grande, eslogan y redes; menú; contacto;
// y la carta del mes (si la sección newsletter está activa). Todo sale de site.yaml.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false (plan gratis).
import { site, tel, whatsapp, mapa, seccion, cadena } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'tipografico' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const carta = seccion('newsletter');
const anio = new Date().getFullYear();
---

<footer class={`pie pie--${variante} banda-tinta`}>
  <div class="contenedor">
    <div class="pie-rejilla">
      <div>
        <p class="pie-nombre"><span aria-hidden="true">¶</span>{site.nombre}</p>
        {site.eslogan && <p class="pie-eslogan mt-4">{site.eslogan}</p>}
        {
          redes.length > 0 && (
            <ul class="pie-redes">
              {redes.map(([red, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" aria-label={red}>
                    <Icono nombre={red} tam={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        site.menu.length > 0 && (
          <nav aria-label="Menú del pie">
            <p class="pie-titulo">Índice</p>
            <ul class="pie-lista">
              {site.menu.map((e) => (
                <li>
                  <a href={e.url}>{e.texto}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        (c.telefono || c.whatsapp || c.email || c.direccion || c.horario) && (
          <div>
            <p class="pie-titulo">Contacto</p>
            <ul class="pie-lista">
              {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
              {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
              {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
              {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
              {c.horario && <li class="suave">{c.horario}</li>}
            </ul>
          </div>
        )
      }
      {
        carta && (cadena(carta.titulo) || cadena(carta.texto)) && (
          <div>
            <p class="pie-titulo">{cadena(carta.antetitulo) || 'Newsletter'}</p>
            {cadena(carta.titulo) && <p class="font-display text-2xl leading-tight">{carta.titulo}</p>}
            <a class="enlace-flecha mt-3" href="/#newsletter">Apuntarme</a>
          </div>
        )
      }
    </div>
    <div class="pie-legal">
      <span>© {anio} {site.nombre}</span>
      <a href="/aviso-legal">Aviso legal y privacidad</a>
      {
        site.marca_pie && (
          <span class="pie-noexpertise">
            Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
          </span>
        )
      }
    </div>
  </div>
</footer>
