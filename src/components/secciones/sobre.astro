---
// Sobre mí: fila 50/50 a sangre con la foto tocando el borde izquierdo y, a la derecha, titular, `declaracion`
// en cursiva con filete bermellón, `texto` en párrafos con capitular, `items` (credenciales con icono) y `cta`.
// `galeria` opcional: franja de fotos de borde a borde, sin márgenes, debajo. Sin imagen, el texto va en el
// contenedor (dos columnas en escritorio). Todo lo vacío se omite.
import { seccion, parrafos, cadena, enlace } from '../../data/site';
import { altGaleria, altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const declaracion = cadena(s?.declaracion);
const cta = enlace(s?.cta);
const texto = parrafos(s?.texto);
const fotos = (s?.galeria ?? []).slice(0, 8);
const rejillaFotos = fotos.length >= 4 ? 'grid-cols-2 md:grid-cols-4' : fotos.length === 3 ? 'grid-cols-3' : fotos.length === 2 ? 'grid-cols-2' : 'grid-cols-1';
const hayTexto = !!(s && (s.titulo || s.antetitulo || declaracion || texto.length || s.items.length));
---

{
  s && (hayTexto || s.imagen || s.galeria.length > 0) && (
    <section id={Astro.props.id} class="banda-papel">
      {hayTexto && (
        <div class:list={[s.imagen ? 'fila-sangre' : 'contenedor seccion']}>
          {s.imagen && (
            <div class="fila-sangre-foto">
              <Imagen src={s.imagen} alt={altSeccion(s)} ancho={900} alto={1200} />
            </div>
          )}
          <div class:list={[s.imagen ? 'fila-sangre-texto fila-sangre-texto--der' : 'grid gap-10 lg:grid-cols-2 lg:gap-16']}>
            <div>
              <Titular antetitulo={s.antetitulo} titulo={s.titulo} class="mb-8!" />
              {declaracion && <p class="declaracion mt-8">{declaracion}</p>}
            </div>
            <div>
              {texto.length > 0 && (
                <div class:list={['texto-lectura lectura text-[1.1rem]', s.imagen && 'mt-10']}>
                  {texto.map((p) => <p>{p}</p>)}
                </div>
              )}
              {s.items.length > 0 && (
                <ul class="credenciales mt-10">
                  {s.items.map((it) => (
                    <li>
                      <span class="grid size-11 place-items-center bg-texto text-fondo">
                        <Icono nombre={it.icono} tam={20} />
                      </span>
                      <div>
                        <p class="maquina font-semibold">{it.titulo}</p>
                        {it.texto && <p class="suave mt-1">{it.texto}</p>}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
              {cta && <a class="btn mt-10" href={cta.url}>{cta.texto}</a>}
            </div>
          </div>
        </div>
      )}
      {!hayTexto && s.imagen && <Imagen src={s.imagen} alt={altSeccion(s)} ancho={2100} alto={900} class="franja-foto" />}
      {s.galeria.length > 0 && (
        <ul class:list={['franja-fotos', rejillaFotos]} aria-label="Fotos">
          {fotos.map((g, i) => (
            <li>
              <Imagen src={g} alt={altGaleria(i)} ancho={800} alto={600} />
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}
