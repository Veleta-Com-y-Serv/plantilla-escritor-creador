---
// Prensa y lectores: banda de papel tostado. La primera reseña, enorme en cursiva a todo el ancho; el resto,
// en columnas de periódico (2-3) separadas por reglas finas. `testimonios: [{texto, autor, nota}]`: `autor` es el
// medio o la persona, `nota` sobre qué obra. Sin testimonios no se pinta (la plataforma nunca los inventa).
import { seccion, cadena } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = (s?.testimonios ?? []).filter((t) => cadena(t?.texto));
const [primera, ...resto] = lista;
const cols = Math.min(Math.max(resto.length, 1), 3);
---

{
  s && primera && (
    <section id={Astro.props.id} class="seccion banda-tostado">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <figure class="max-w-[76rem]">
          <blockquote class="recorte-grande">
            <p>«{primera.texto}»</p>
          </blockquote>
          <figcaption class="fuente">
            {cadena(primera.autor)}
            {cadena(primera.nota) && <em> · {primera.nota}</em>}
          </figcaption>
        </figure>
        {resto.length > 0 && (
          <div class="columnas" style={`--cols:${cols}`}>
            {resto.map((t) => (
              <figure>
                <blockquote class="recorte">
                  <p>«{t.texto}»</p>
                </blockquote>
                <figcaption class="fuente">
                  {cadena(t.autor)}
                  {cadena(t.nota) && <em> · {t.nota}</em>}
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
